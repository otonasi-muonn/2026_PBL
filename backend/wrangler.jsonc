{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-05",
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],

  // 参考: https://aistudio.google.com/docs/models
  "vars": {
    // OpenAI互換
    "LLM_BASE_URL": "https://generativelanguage.googleapis.com/v1beta/openai",
    // MEMO: 2026/11/14 時点で提供されているモデル
    "SPLIT_MODEL": "gemini-3.8-flash", // ミドルモデル
    "PRAISE_MODEL": "gemini-3.5-flash-lite", // ライトモデル
    "SPLIT_FALLBACK_MODEL": "gemini-3.6-flash",
    "PRAISE_FALLBACK_MODEL": "gemini-3.1-flash-lite",
    "USE_MOCK": "true", // デフォルトの "true" ならモック，それ以外なら LLM (.dev.vars で上書き)
  },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
